# ─── Shared ─────────────────────────────────────────────
NODE_ENV=development
TZ=Asia/Bangkok

# ─── Database (Supabase) ───────────────────────────────
# Pooled connection (Prisma queries) — port 6543
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (Prisma migrate / introspect) — port 5432
DIRECT_URL=postgresql://postgres.<project>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ─── API (apps/api on Render) ──────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

# JWT — 256-bit secret (openssl rand -base64 32)
JWT_SECRET=replace_with_random_secret_min_32_bytes
JWT_EXPIRES_IN=7d

# LINE — Login (LIFF) channel
LINE_CHANNEL_ID=1234567890
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LINE — Messaging API channel (for Push)
LINE_MESSAGING_TOKEN=long-lived-channel-access-token
LIFF_ID=1234567890-abcdefgh

# PromptPay default QR target (phone or national ID)
PROMPTPAY_ID=0812345678

# Admin seed (used by pnpm db:seed)
ADMIN_SEED_EMAIL=admin@maoleaw.local
ADMIN_SEED_PASSWORD=ChangeMe-Temp-1234
ADMIN_SEED_NAME=Admin

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Sentry (optional)
SENTRY_DSN=

# ─── LIFF app (apps/liff on Vercel) ────────────────────
NEXT_PUBLIC_LIFF_ID=1234567890-abcdefgh
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PROMPTPAY_ID=0812345678

# ─── Admin app (apps/admin on Vercel) ──────────────────
# (server-only — Next.js server actions call API)
ADMIN_API_URL=http://localhost:4000
ADMIN_COOKIE_SECRET=replace_with_random_32_bytes
