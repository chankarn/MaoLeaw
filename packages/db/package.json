  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "bcrypt": "^5.1.1",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.9.0"
  }
