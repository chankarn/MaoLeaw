{
  "name": "maoleaw",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "db:generate": "pnpm --filter @maoleaw/db generate",
    "db:migrate": "pnpm --filter @maoleaw/db migrate",
    "db:deploy": "pnpm --filter @maoleaw/db deploy",
    "db:seed": "pnpm --filter @maoleaw/db seed",
    "db:studio": "pnpm --filter @maoleaw/db studio",
    "e2e": "pnpm --filter @maoleaw/e2e test",
    "e2e:ui": "pnpm --filter @maoleaw/e2e test:ui",
    "e2e:admin": "pnpm --filter @maoleaw/e2e test:admin",
    "e2e:liff": "pnpm --filter @maoleaw/e2e test:liff",
    "e2e:install": "pnpm --filter @maoleaw/e2e exec playwright install --with-deps chromium",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "@types/node": "^22.9.0"
  }
}
